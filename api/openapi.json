{
  "components" : {
    "schemas" : {
      "Claims" : {
        "properties" : {
          "playerIds" : {
            "description" : "The Players that an Account has claimed",
            "items" : {
              "format" : "uuid",
              "type" : "string"
            },
            "type" : "array"
          }
        },
        "required" : [ "playerIds" ],
        "type" : "object"
      },
      "CurrentAccount" : {
        "properties" : {
          "id" : {
            "format" : "uuid",
            "type" : "string"
          },
          "language" : {
            "enum" : [ "en", "nl", "hu" ],
            "type" : "string"
          },
          "permissions" : {
            "items" : {
              "enum" : [ "CREATE_PLAYERS", "EDIT_PLAYERS", "REMOVE_PLAYERS", "CREATE_PLAYS", "MANAGE_INVITES", "MANAGE_ACCOUNTS", "MANAGE_ROLES" ],
              "type" : "string"
            },
            "type" : "array",
            "uniqueItems" : true
          },
          "playerId" : {
            "format" : "uuid",
            "type" : "string"
          },
          "playerName" : {
            "type" : "string"
          },
          "username" : {
            "type" : "string"
          }
        },
        "required" : [ "id", "language", "permissions", "playerId", "playerName", "username" ],
        "type" : "object"
      },
      "FieldProblem" : {
        "description" : "For the code request.invalid: the fields that broke a rule",
        "properties" : {
          "code" : {
            "description" : "The rule that was broken, such as size or notblank",
            "type" : "string"
          },
          "field" : {
            "type" : "string"
          }
        },
        "required" : [ "code", "field" ]
      },
      "Game" : {
        "properties" : {
          "gameModuleId" : {
            "format" : "uuid",
            "type" : "string"
          },
          "id" : {
            "format" : "uuid",
            "type" : "string"
          },
          "name" : {
            "type" : "string"
          }
        },
        "required" : [ "gameModuleId", "id", "name" ],
        "type" : "object"
      },
      "GameModule" : {
        "properties" : {
          "id" : {
            "format" : "uuid",
            "type" : "string"
          },
          "key" : {
            "type" : "string"
          }
        },
        "required" : [ "id", "key" ],
        "type" : "object"
      },
      "Invite" : {
        "properties" : {
          "expired" : {
            "type" : "boolean"
          },
          "expiresAt" : {
            "format" : "date-time",
            "type" : "string"
          },
          "id" : {
            "format" : "uuid",
            "type" : "string"
          },
          "playerId" : {
            "format" : "uuid",
            "type" : "string"
          },
          "roleId" : {
            "format" : "uuid",
            "type" : "string"
          }
        },
        "required" : [ "expired", "expiresAt", "id", "playerId", "roleId" ],
        "type" : "object"
      },
      "InviteRequest" : {
        "properties" : {
          "playerId" : {
            "format" : "uuid",
            "type" : "string"
          },
          "roleId" : {
            "description" : "The Role the new Account starts with. Member if left out.",
            "format" : "uuid",
            "type" : "string"
          }
        },
        "required" : [ "playerId" ],
        "type" : "object"
      },
      "LanguageRequest" : {
        "properties" : {
          "language" : {
            "enum" : [ "en", "nl", "hu" ],
            "type" : "string"
          }
        },
        "required" : [ "language" ],
        "type" : "object"
      },
      "NewInvite" : {
        "properties" : {
          "invite" : {
            "$ref" : "#/components/schemas/Invite"
          },
          "token" : {
            "description" : "The secret part of the link: the person registers at /register/{token}",
            "type" : "string"
          }
        },
        "required" : [ "invite", "token" ],
        "type" : "object"
      },
      "Player" : {
        "properties" : {
          "id" : {
            "format" : "uuid",
            "type" : "string"
          },
          "name" : {
            "type" : "string"
          }
        },
        "required" : [ "id", "name" ],
        "type" : "object"
      },
      "PlayerRequest" : {
        "properties" : {
          "name" : {
            "maxLength" : 50,
            "minLength" : 0,
            "type" : "string"
          }
        },
        "required" : [ "name" ],
        "type" : "object"
      },
      "Problem" : {
        "properties" : {
          "code" : {
            "description" : "What went wrong, as a code for the frontend to translate, such as players.nameTaken",
            "type" : "string"
          },
          "detail" : {
            "type" : "string"
          },
          "errors" : {
            "description" : "For the code request.invalid: the fields that broke a rule",
            "items" : {
              "$ref" : "#/components/schemas/FieldProblem"
            },
            "type" : "array"
          },
          "status" : {
            "description" : "The HTTP status",
            "format" : "int32",
            "type" : "integer"
          },
          "title" : {
            "type" : "string"
          }
        },
        "required" : [ "status" ]
      },
      "Registration" : {
        "properties" : {
          "expiresAt" : {
            "format" : "date-time",
            "type" : "string"
          },
          "playerName" : {
            "description" : "The Player the new Account will claim",
            "type" : "string"
          }
        },
        "required" : [ "expiresAt", "playerName" ],
        "type" : "object"
      },
      "RegistrationRequest" : {
        "properties" : {
          "language" : {
            "enum" : [ "en", "nl", "hu" ],
            "type" : "string"
          },
          "password" : {
            "maxLength" : 200,
            "minLength" : 16,
            "type" : "string"
          },
          "username" : {
            "pattern" : "[\\p{L}\\p{N}._-]{3,30}",
            "type" : "string"
          }
        },
        "required" : [ "language", "password", "username" ],
        "type" : "object"
      },
      "Role" : {
        "properties" : {
          "builtIn" : {
            "description" : "ADMIN or MEMBER for the two built-in Roles; absent for any other",
            "enum" : [ "ADMIN", "MEMBER" ],
            "type" : "string"
          },
          "id" : {
            "format" : "uuid",
            "type" : "string"
          },
          "name" : {
            "type" : "string"
          },
          "permissions" : {
            "items" : {
              "enum" : [ "CREATE_PLAYERS", "EDIT_PLAYERS", "REMOVE_PLAYERS", "CREATE_PLAYS", "MANAGE_INVITES", "MANAGE_ACCOUNTS", "MANAGE_ROLES" ],
              "type" : "string"
            },
            "type" : "array",
            "uniqueItems" : true
          }
        },
        "required" : [ "id", "name", "permissions" ],
        "type" : "object"
      },
      "Session" : {
        "properties" : {
          "account" : {
            "$ref" : "#/components/schemas/CurrentAccount",
            "description" : "The signed-in Account. Absent when nobody is signed in."
          }
        },
        "type" : "object"
      },
      "SetupRequest" : {
        "properties" : {
          "language" : {
            "enum" : [ "en", "nl", "hu" ],
            "type" : "string"
          },
          "password" : {
            "maxLength" : 200,
            "minLength" : 16,
            "type" : "string"
          },
          "playerName" : {
            "description" : "The name of the Player that the new Account claims",
            "maxLength" : 50,
            "minLength" : 0,
            "type" : "string"
          },
          "token" : {
            "minLength" : 1,
            "type" : "string"
          },
          "username" : {
            "pattern" : "[\\p{L}\\p{N}._-]{3,30}",
            "type" : "string"
          }
        },
        "required" : [ "language", "password", "playerName", "token", "username" ],
        "type" : "object"
      },
      "SetupStatus" : {
        "properties" : {
          "required" : {
            "type" : "boolean"
          }
        },
        "required" : [ "required" ],
        "type" : "object"
      },
      "SignInRequest" : {
        "properties" : {
          "password" : {
            "maxLength" : 200,
            "minLength" : 0,
            "type" : "string"
          },
          "staySignedIn" : {
            "description" : "Stay signed in on this device for 90 days after the last visit",
            "type" : "boolean"
          },
          "username" : {
            "maxLength" : 30,
            "minLength" : 0,
            "type" : "string"
          }
        },
        "required" : [ "password", "staySignedIn", "username" ],
        "type" : "object"
      }
    }
  },
  "info" : {
    "title" : "Board Keeper API",
    "version" : "1"
  },
  "openapi" : "3.1.0",
  "paths" : {
    "/api/account/language" : {
