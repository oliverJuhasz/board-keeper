<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.oliverjuhasz.boardkeeper</groupId>
        <artifactId>board-keeper</artifactId>
        <version>0-SNAPSHOT</version>
    </parent>

    <artifactId>app</artifactId>
    <name>Board Keeper: Application</name>
    <description>The Spring Boot application: the core, plus every Game Module on its classpath.</description>

    <properties>
        <!-- Where the built frontend is picked up from, to be served by Spring Boot. -->
        <frontend.dist>${project.basedir}/../../frontend/dist</frontend.dist>
        <!-- The committed description of the API, which the frontend's types are generated from. -->
        <boardkeeper.openapi.file>${project.basedir}/../../api/openapi.json</boardkeeper.openapi.file>
    </properties>

    <dependencies>
        <!-- The contract with Game Modules. The core compiles against this only. -->
        <dependency>
            <groupId>io.github.oliverjuhasz.boardkeeper</groupId>
            <artifactId>game-api</artifactId>
        </dependency>

        <!-- Game Modules. "runtime" scope puts them in the application but hides them from the
             compiler, so core code cannot reach into a Game Module. -->
        <dependency>
            <groupId>io.github.oliverjuhasz.boardkeeper</groupId>
            <artifactId>game-generic</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.github.oliverjuhasz.boardkeeper</groupId>
            <artifactId>game-calico</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.github.oliverjuhasz.boardkeeper</groupId>
            <artifactId>game-harmonies</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.github.oliverjuhasz.boardkeeper</groupId>
            <artifactId>game-wyrmspan</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.github.oliverjuhasz.boardkeeper</groupId>
            <artifactId>game-hadara</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.github.oliverjuhasz.boardkeeper</groupId>
            <artifactId>game-seven-wonders</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.github.oliverjuhasz.boardkeeper</groupId>
            <artifactId>game-seven-wonders-duel</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.github.oliverjuhasz.boardkeeper</groupId>
            <artifactId>game-spirit-island</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.github.oliverjuhasz.boardkeeper</groupId>
            <artifactId>game-last-bastion</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- Checks request bodies against annotations such as @Size(min = 16). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <!-- Passkeys: Spring Security's WebAuthn support, which checks what a phone or a security
             key signs. It brings the WebAuthn4J library, which does the cryptography. -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-webauthn</artifactId>
        </dependency>
        <!-- Keeps signed-in sessions in PostgreSQL instead of in memory (ADR 0013). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-session-jdbc</artifactId>
        </dependency>
        <!-- The Argon2 password hashing that Spring Security uses comes from Bouncy Castle. -->
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk18on</artifactId>
            <version>${bouncycastle.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jooq</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-starter-core</artifactId>
        </dependency>
        <!-- Stores every event a module publishes in the database until its listeners have
             handled it, so none is lost when the application stops halfway (ADR 0011). -->
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-starter-jdbc</artifactId>
        </dependency>
        <!-- Publishes the OpenAPI description at /v3/api-docs and Swagger UI at /swagger-ui.html. -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- A pretend authenticator, which creates and uses passkeys the way a phone does. -->
        <dependency>
            <groupId>com.webauthn4j</groupId>
            <artifactId>webauthn4j-test</artifactId>
            <version>${webauthn4j.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- The application is built as target/board-keeper.jar. -->
        <finalName>board-keeper</finalName>
        <plugins>
            <!--
              jOOQ code generation from a real PostgreSQL (ADR 0007). Three steps run in the
              generate-sources phase, in the order they are declared here:

                1. gmavenplus: start a throwaway PostgreSQL with Testcontainers and publish its
                   connection details as Maven properties.
                2. flyway: apply the migrations to it.
                3. jooq-codegen: generate Java code from the resulting schema.

              The container is stopped again in the following phase.
            -->
            <plugin>
                <groupId>org.codehaus.gmavenplus</groupId>
                <artifactId>gmavenplus-plugin</artifactId>
                <version>${gmavenplus-plugin.version}</version>
                <executions>
                    <execution>
                        <id>start-codegen-database</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>execute</goal>
                        </goals>
                        <configuration>
                            <scripts>
                                <script><![CDATA[
                                    def database = new org.testcontainers.postgresql.PostgreSQLContainer('${postgres.image}')
                                    database.start()
                                    project.properties.setProperty('codegen.db.url', database.jdbcUrl)
                                    project.properties.setProperty('codegen.db.username', database.username)
                                    project.properties.setProperty('codegen.db.password', database.password)
                                    project.setContextValue('codegen.db', database)
                                ]]></script>
                            </scripts>
                        </configuration>
                    </execution>
                    <execution>
                        <id>stop-codegen-database</id>
                        <phase>process-sources</phase>
                        <goals>
                            <goal>execute</goal>
                        </goals>
                        <configuration>
                            <scripts>
                                <script><![CDATA[
                                    project.getContextValue('codegen.db')?.stop()
                                ]]></script>
                            </scripts>
                        </configuration>
                    </execution>
                </executions>
                <dependencies>
                    <dependency>
                        <groupId>org.apache.groovy</groupId>
                        <artifactId>groovy</artifactId>
                        <version>${groovy.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>org.testcontainers</groupId>
                        <artifactId>testcontainers-postgresql</artifactId>
                        <version>${testcontainers.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>org.postgresql</groupId>
                        <artifactId>postgresql</artifactId>
                        <version>${postgresql.version}</version>
                    </dependency>
                </dependencies>
            </plugin>
            <plugin>
                <groupId>org.flywaydb</groupId>
                <artifactId>flyway-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>migrate-codegen-database</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>migrate</goal>
                        </goals>
                        <configuration>
                            <url>${codegen.db.url}</url>
                            <user>${codegen.db.username}</user>
                            <password>${codegen.db.password}</password>
                            <locations>
                                <location>filesystem:${project.basedir}/src/main/resources/db/migration</location>
                            </locations>
                        </configuration>
                    </execution>
                </executions>
                <dependencies>
                    <dependency>
                        <groupId>org.flywaydb</groupId>
                        <artifactId>flyway-database-postgresql</artifactId>
                        <version>${flyway.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>org.postgresql</groupId>
                        <artifactId>postgresql</artifactId>
                        <version>${postgresql.version}</version>
                    </dependency>
                </dependencies>
            </plugin>
            <plugin>
                <groupId>org.jooq</groupId>
                <artifactId>jooq-codegen-maven</artifactId>
                <executions>
                    <execution>
                        <id>generate-jooq</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <jdbc>
                                <url>${codegen.db.url}</url>
                                <user>${codegen.db.username}</user>
                                <password>${codegen.db.password}</password>
                            </jdbc>
                            <generator>
                                <database>
                                    <name>org.jooq.meta.postgres.PostgresDatabase</name>
                                    <inputSchema>public</inputSchema>
                                    <!-- Don't write the schema name into generated SQL. -->
                                    <outputSchemaToDefault>true</outputSchemaToDefault>
                                    <!-- Flyway's bookkeeping table, Spring Session's tables, Spring Modulith's event
                                         registry and Spring Security's passkey tables are not part
                                         of the model: those libraries use them themselves. -->
                                    <excludes>flyway_schema_history | spring_session.* | event_publication | user_entities | user_credentials</excludes>
                                </database>
                                <target>
                                    <packageName>io.github.oliverjuhasz.boardkeeper.jooq</packageName>
                                    <directory>${project.build.directory}/generated-sources/jooq</directory>
                                </target>
                            </generator>
                        </configuration>
                    </execution>
                </executions>
                <dependencies>
                    <dependency>
                        <groupId>org.postgresql</groupId>
                        <artifactId>postgresql</artifactId>
                        <version>${postgresql.version}</version>
                    </dependency>
                </dependencies>
            </plugin>

            <!-- Puts the built frontend into the application, where Spring Boot serves it from
                 "static/". Build the frontend first (npm run build in frontend/); if its dist/
                 folder does not exist, the application is built without a user interface. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-frontend</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}/static</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${frontend.dist}</directory>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- Mockito attaches itself to the running JVM. Newer JDKs warn about that unless told it is expected. -->
                    <argLine>-XX:+EnableDynamicAgentLoading</argLine>
                    <!-- Anything passed to Maven with -D, such as -Dboardkeeper.openapi.update=true, reaches the tests as well. -->
                    <systemPropertyVariables>
                        <boardkeeper.openapi.file>${boardkeeper.openapi.file}</boardkeeper.openapi.file>
                        <boardkeeper.postgres.image>${postgres.image}</boardkeeper.postgres.image>
                    </systemPropertyVariables>
                </configuration>
            </plugin>

            <!--
              Records what git knows about the build in git.properties, which Spring Boot reads into a
              GitProperties bean. The About page takes Board Keeper's version from it (ADR 0018) and
              the address of its source code (ADR 0016):
              - the commit, its time, and whether files were changed since ("dirty");
              - the tags on the commit: built from a release's tag, this is that release;
              - the newest release before the commit, and how many commits it is behind.
              Only these are recorded: by default the plugin would also write who built it, on which
              machine, and their e-mail address, into a jar that is published. Building from a copy
              without Git still works, and Board Keeper then doesn't know its version.
            -->
            <plugin>
                <groupId>io.github.git-commit-id</groupId>
                <artifactId>git-commit-id-maven-plugin</artifactId>
                <configuration>
                    <verbose>false</verbose>
                    <failOnNoGitDirectory>false</failOnNoGitDirectory>
                    <!-- Which tags to look at for the newest release: those with two dots, such as
                         1.2.3, also plain ones, as "git tag 1.2.3" makes. The pattern knows only "*";
                         Build checks that the parts are numbers. -->
                    <gitDescribe>
                        <tags>true</tags>
                        <match>*.*.*</match>
                    </gitDescribe>
                    <includeOnlyProperties>
                        <includeOnlyProperty>^git\.commit\.id$</includeOnlyProperty>
                        <includeOnlyProperty>^git\.commit\.time$</includeOnlyProperty>
                        <includeOnlyProperty>^git\.dirty$</includeOnlyProperty>
                        <includeOnlyProperty>^git\.tags$</includeOnlyProperty>
                        <includeOnlyProperty>^git\.closest\.tag\.name$</includeOnlyProperty>
                        <includeOnlyProperty>^git\.closest\.tag\.commit\.count$</includeOnlyProperty>
                    </includeOnlyProperties>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <skip>false</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
