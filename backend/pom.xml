<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd"
         child.project.url.inherit.append.path="false">
    <modelVersion>4.0.0</modelVersion>

    <!-- Inheriting from Spring Boot's parent gives every module tested, matching versions
         of the libraries and Maven plugins Boot knows about (jOOQ, Flyway, Testcontainers, ...). -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/>
    </parent>

    <groupId>io.github.oliverjuhasz.boardkeeper</groupId>
    <artifactId>board-keeper</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Board Keeper</name>
    <url>https://github.com/oliverJuhasz/board-keeper</url>

    <!-- Board Keeper's own licence (ADR 0016). Spring Boot's parent names its own licence, developers
         and repository, and Maven would pass them on to every module unless they are given here. -->
    <licenses>
        <license>
            <name>AGPL-3.0-or-later</name>
            <url>https://www.gnu.org/licenses/agpl-3.0.html</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <developers>
        <developer>
            <id>oliverJuhasz</id>
            <name>Oliver Juhasz</name>
            <url>https://github.com/oliverJuhasz</url>
        </developer>
    </developers>
    <scm child.scm.url.inherit.append.path="false">
        <url>https://github.com/oliverJuhasz/board-keeper</url>
    </scm>

    <modules>
        <module>game-api</module>
        <module>games/generic</module>
        <module>games/calico</module>
        <module>games/harmonies</module>
        <module>games/wyrmspan</module>
        <module>games/hadara</module>
        <module>games/seven-wonders</module>
        <module>games/seven-wonders-duel</module>
        <module>games/spirit-island</module>
        <module>app</module>
    </modules>

    <properties>
        <java.version>25</java.version>
        <!-- Not managed by Spring Boot, so versioned here. -->
        <spring-modulith.version>2.1.2</spring-modulith.version>
        <springdoc.version>3.2.0</springdoc.version>
        <bouncycastle.version>1.86</bouncycastle.version>
        <gmavenplus-plugin.version>5.1.0</gmavenplus-plugin.version>
        <groovy.version>5.1.3</groovy.version>
        <!-- The WebAuthn4J that spring-security-webauthn depends on, for the authenticator that
             tests use in place of a phone. Keep it in step with Spring Security's. -->
        <webauthn4j.version>0.31.10.RELEASE</webauthn4j.version>
        <!-- The PostgreSQL used for jOOQ code generation and tests. Keep it in step with deploy/compose.yaml. -->
        <postgres.image>postgres:18-alpine</postgres.image>
    </properties>

    <build>
        <pluginManagement>
            <plugins>
                <!-- Lets "./mvnw spring-boot:test-run" be started from this folder: the goal is
                     skipped in every module except app, which switches it back on. -->
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <configuration>
                        <skip>true</skip>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <dependencyManagement>
        <dependencies>
            <!-- Every part of Bouncy Castle in one version: the app's Argon2 uses bcprov, and the
                 test authenticator (webauthn4j-test) brings bcpkix and bcutil, which must match it. -->
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bcpkix-jdk18on</artifactId>
                <version>${bouncycastle.version}</version>
            </dependency>
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bcutil-jdk18on</artifactId>
                <version>${bouncycastle.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springframework.modulith</groupId>
                <artifactId>spring-modulith-bom</artifactId>
                <version>${spring-modulith.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.github.oliverjuhasz.boardkeeper</groupId>
                <artifactId>game-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.oliverjuhasz.boardkeeper</groupId>
                <artifactId>game-generic</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.oliverjuhasz.boardkeeper</groupId>
                <artifactId>game-calico</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.oliverjuhasz.boardkeeper</groupId>
                <artifactId>game-harmonies</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.oliverjuhasz.boardkeeper</groupId>
                <artifactId>game-wyrmspan</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.oliverjuhasz.boardkeeper</groupId>
                <artifactId>game-hadara</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.oliverjuhasz.boardkeeper</groupId>
                <artifactId>game-seven-wonders</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.oliverjuhasz.boardkeeper</groupId>
                <artifactId>game-seven-wonders-duel</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.oliverjuhasz.boardkeeper</groupId>
                <artifactId>game-spirit-island</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
