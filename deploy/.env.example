# Copy this file to .env and set your own values. Never commit .env.

# The password of the database user. Choose a long random one.
POSTGRES_PASSWORD=change-me

# The address people open Board Keeper at, with https://. Passkeys belong to one address, so
# they need it; leave it out and Board Keeper offers no passkeys.
# BOARDKEEPER_URL=https://boardkeeper.example.com

# The port on this machine that Board Keeper answers on.
BOARD_KEEPER_PORT=8080

# The image to run. Leave it out to use the newest release. docs/self-hosting.md lists the other
# tags, such as one release (1.2.3) or the newest change (snapshot).
# BOARD_KEEPER_IMAGE=ghcr.io/oliverjuhasz/board-keeper:latest
