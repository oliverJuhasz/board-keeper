# Copy this file to .env and set your own values. Never commit .env.

# The password of the database user. Choose a long random one.
POSTGRES_PASSWORD=change-me

# The port on this machine that Board Keeper answers on.
BOARD_KEEPER_PORT=8080

# The image to run. Leave it out to use the latest published one.
# BOARD_KEEPER_IMAGE=ghcr.io/oliverjuhasz/board-keeper:latest
