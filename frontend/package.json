{
  "name": "board-keeper-frontend",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "generate:api": "openapi-typescript ../api/openapi.json -o src/api/schema.d.ts",
    "prepare": "npm run generate:api",
    "predev": "npm run generate:api",
    "dev": "vite",
    "prebuild": "npm run generate:api",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@hookform/resolvers": "^7.0.5",
    "@tanstack/query-async-storage-persister": "^5.107.1",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-query-persist-client": "^5.107.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "i18next": "^27.1.1",
    "i18next-browser-languagedetector": "^8.3.0",
    "lucide-react": "^1.71.0",
    "openapi-fetch": "^0.17.0",
    "openapi-react-query": "^0.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-i18next": "^18.0.1",
    "react-router": "^8.5.1",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "workbox-window": "^7.4.1",
    "zod": "^4.6.7"
